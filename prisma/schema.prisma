// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type AddressType {
  street String
  city   String
  state  String
  zip    String
}

type RankingType {
  rankingPodiums Int
  rankingWins    Int
  totalRaces     Int
}

type RaceSessions {
  practiceMinutes Int
  qualyMinutes    Int
  raceMinutes     Int
  raceLaps        Int?
}

model AuthToken {
  token   String  @id @default(auto()) @map("_id") @db.ObjectId
  time    Int
  date    DateTime
  expired Boolean

  racerProfileId String?       @db.ObjectId
  racerProfile   RacerProfile? @relation(fields: [racerProfileId], references: [id])

  trackProfileId String?       @db.ObjectId
  trackProfile   TrackProfile? @relation(fields: [trackProfileId], references: [id])
}

model RacerProfile {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  birthDate String
  whatsapp  String      @unique
  cpf       String?
  password  String
  ranking   RankingType

  tracksUnlockedIds String[]       @db.ObjectId
  tracksUnlocked    TrackProfile[] @relation(fields: [tracksUnlockedIds], references: [id])

  raceIds String[] @db.ObjectId
  races   Race[]   @relation(name: "RaceParticipants", fields: [raceIds], references: [id])

  hostedRaceIds String[] @db.ObjectId
  hostedRaces   Race[]   @relation(name: "RaceHost")

  bestLaps TrackBestLap[]
  trackRecords TrackRecord[]
  authToken AuthToken[]

  friends SocialFriendship[]
}

model Chat {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  
  senderId String
  message String

  createdAt DateTime @updatedAt

  chatWithFriendshipId String @db.ObjectId
  chatWithFriendship SocialFriendship @relation(fields: [chatWithFriendshipId], references: [id])
}

model SocialFriendship {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  
  chat        Chat[]
  accepted    Boolean

  racerFriendId String @db.ObjectId
  racerFriend RacerProfile @relation(fields: [racerFriendId], references: [id])

  racerId String @db.ObjectId
}

model TrackProfile {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  email             String      @unique
  password          String
  name              String
  availabilityStart String
  availabilityEnd   String
  raceIntervals     Int
  address           AddressType
  addressGoogleURL  String
  whatsapp          String
  website           String
  trackModes        String[]

  racersProfileIds String[]       @db.ObjectId
  racersProfiles   RacerProfile[] @relation(fields: [racersProfileIds], references: [id])

  categories   RaceCategories[]
  bestLaps TrackBestLap[]
  races        Race[]

  authToken AuthToken[]
}

model RaceCategories {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  price          String
  equipmentPrice String

  trackProfileId String       @db.ObjectId
  trackProfile   TrackProfile @relation(fields: [trackProfileId], references: [id])

  races Race[]
  trackRecords TrackRecord[]
}

model Race {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  date        String
  time        String
  trackMode   String?
  sessions    RaceSessions
  isFinished  Boolean
  isScheduled Boolean
  isReserved  Boolean

  categoryId String?         @db.ObjectId
  category   RaceCategories? @relation(fields: [categoryId], references: [id])

  trackId String       @db.ObjectId
  track   TrackProfile @relation(fields: [trackId], references: [id])

  racerHost        String?       @db.ObjectId
  racerHostProfile RacerProfile? @relation(name: "RaceHost", fields: [racerHost], references: [id])

  racersProfileIds String[]       @db.ObjectId
  racersProfiles   RacerProfile[] @relation(name: "RaceParticipants", fields: [racersProfileIds], references: [id])

  raceResult RaceResult? @relation("raceResult")
}

model RaceResult {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId

  raceId        String       @unique @db.ObjectId
  race          Race        @relation(name: "raceResult", fields: [raceId], references: [id])

  trackRecords   TrackRecord[]
}

model TrackRecord {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId

  racePosition      Int
  totalTime         String
  bestLapTime       String
  leaderDifference  String

  racerProfileId      String       @db.ObjectId
  racerProfile RacerProfile @relation(fields: [racerProfileId], references: [id])

  raceCategoryId    String       @db.ObjectId
  raceCategory      RaceCategories @relation(fields: [raceCategoryId], references: [id]) 

  raceResult        RaceResult?  @relation(fields: [raceResultId], references: [id])
  raceResultId      String?      @unique @db.ObjectId

  TrackBestLap TrackBestLap?
}

model TrackBestLap {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  trackMode         String

  trackId           String       @db.ObjectId
  track             TrackProfile @relation(fields: [trackId], references: [id])

  trackRecord TrackRecord? @relation(fields: [trackRecordId], references: [id])
  trackRecordId String? @unique @db.ObjectId 

  racerProfileId      String       @db.ObjectId
  racerProfile RacerProfile @relation(fields: [racerProfileId], references: [id])
}